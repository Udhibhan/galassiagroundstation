options:
  parameters:
    author: Galassia-5 ground station
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Galassia-5 ground-station receiver: B205mini record + monitor /
      live decode / file decode, patched gr-dvbs2rx, optional TLE Doppler pre-comp,
      GSSE/GSUFTP files. Parameters = command-line options (rx_unified.py --help).
      README.md.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: rx_unified
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: G5 unified RX
    window_size: (1500,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: antenna_sel
  id: variable_qtgui_chooser
  parameters:
    comment: ''
    gui_hint: 0,1,1,1
    label: RX port
    label0: RX2
    label1: TX/RX
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: '''RX2'''
    option1: '''TX/RX'''
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1, 2]'
    orient: Qt.QVBoxLayout
    type: string
    value: g5gs.config.antenna_name(antenna)
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 188.0]
    rotation: 0
    state: enabled
- name: cfg
  id: variable
  parameters:
    comment: ''
    value: g5gs.config.resolve(preset, sym_rate, sps, modcod, frame_size)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [330, 8]
    rotation: 0
    state: enabled
- name: cfg_text
  id: variable
  parameters:
    comment: ''
    value: 'f''{mode}: {cfg.describe()}'' + (f'', TLE {tle}'' if tle else '', no TLE'')
      + f'', AGC {agc} {agc_ref:g}, post-AGC {post_agc_ref:g}, period {pl_freq_est_period}''
      + ('', dummy frames'' if dummy_frames else '''')'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [660, 80]
    rotation: 0
    state: enabled
- name: gate_cfg
  id: variable
  parameters:
    comment: ''
    value: g5gs.auto_mode(mode, samp_rate, duty_period)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 8.0]
    rotation: 0
    state: enabled
- name: meta
  id: variable
  parameters:
    comment: ''
    value: '{''preset'': preset, ''modcod'': cfg.modcod, ''frame_size'': cfg.frame_size,
      ''sym_rate'': rs, ''sps'': cfg.sps, ''tle'': tle, ''conj'': bool(conj)}'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 80]
    rotation: 0
    state: enabled
- name: out_dir_eff
  id: variable
  parameters:
    comment: ''
    value: out_dir or g5gs.config.default_out_dir(mode, input_file, rec_dir)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [232, 80.0]
    rotation: 0
    state: enabled
- name: panel_groups
  id: variable
  parameters:
    comment: ''
    value: '{''spectrum'': [''valve_spec_in'', ''valve_spec_pl'', ''qtgui_freq_sink_in'',
      ''qtgui_freq_sink_pl''], ''constellation'': [''valve_const'', ''qtgui_const_sink_pl''],
      ''status'': [''rx_status_panel_0''], ''doppler'': [''doppler_panel_0''], ''files'':
      [''files_panel_0'']}'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [860, 80]
    rotation: 0
    state: enabled
- name: pls_filter
  id: variable
  parameters:
    comment: ''
    value: dvbs2rx.pls_filter(dvbs2rx.dvbs2_pls(cfg.constellation, cfg.code_rate,
      cfg.frame_size, True))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 8.0]
    rotation: 0
    state: enabled
- name: record_on
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': '0'
    gui_hint: 1,1,1,1
    label: Record to disk
    'true': '1'
    type: int
    value: int(mode == 'record') if record < 0 else int(bool(record))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 8.0]
    rotation: 0
    state: enabled
- name: rs
  id: variable
  parameters:
    comment: ''
    value: cfg.sym_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [728, 8.0]
    rotation: 0
    state: enabled
- name: rx_gain_slider
