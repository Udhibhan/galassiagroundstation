options:
  parameters:
    author: Galassia-5 ground station
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Galassia-5 test transmitter: Link X/SX-style GSSE/GSUFTP (or gr-dvbgse
      GSE from tap0, or a BBFRAME file) -> DVB-S2 (gr-dtv) + dummy frames -> transients
      / CFO / TLE Doppler / AWGN -> B205mini or IQ file. README.md.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: tx_unified
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: G5 unified TX
    window_size: (1500,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: carrier_on
  id: variable_qtgui_check_box
  parameters:
    comment: ''
    'false': '0'
    gui_hint: 2,1,1,1
    label: Carrier on
    'true': '1'
    type: int
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 288.0]
    rotation: 0
    state: enabled
- name: cfg
  id: variable
  parameters:
    comment: ''
    value: g5gs.config.resolve(preset, sym_rate, sps, modcod, frame_size)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 8.0]
    rotation: 0
    state: enabled
- name: cfg_text
  id: variable
  parameters:
    comment: ''
    value: f'{cfg.describe()}, payload {payload}' + (f' {files}' if files else '')
      + f', lead {lead_dummies} / gap {gap_dummies} dummies' + (f', TLE {tle}' if
      tle else '')
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 8.0]
    rotation: 0
    state: enabled
- name: cfo_slider
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 2,0,1,1
    label: CFO (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: -0.2 * rs
    step: '100'
    stop: 0.2 * rs
    value: cfo_hz
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1064, 152.0]
    rotation: 0
    state: enabled
- name: dop_start
  id: variable
  parameters:
    comment: ''
    value: g5gs.tx.doppler_start(tle, doppler_start_utc)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [432, 80.0]
    rotation: 0
    state: enabled
- name: level_slider
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,1,1,1
    label: 'Level (dB, digital: fades / steps)'
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-60'
    step: '1'
    stop: '10'
    value: level_db
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1296, 160.0]
    rotation: 0
    state: enabled
- name: panel_groups
  id: variable
  parameters:
    comment: ''
    value: '{''spectrum'': [''valve_spec'', ''qtgui_freq_sink_tx''], ''status'': [''tx_status_panel_0'']}'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [632, 80.0]
    rotation: 0
    state: enabled
- name: rs
  id: variable
  parameters:
    comment: ''
    value: cfg.sym_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [536, 80.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: cfg.samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [496, 8.0]
    rotation: 0
    state: enabled
- name: sig_power
  id: variable
  parameters:
    comment: ''
    value: g5gs.tx.signal_power(source, replay_file, cfg.sps)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [312, 80.0]
    rotation: 0
    state: enabled
- name: tx_gain_slider
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: 1,0,1,1
    label: TX gain (dB, B205mini)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '89'
    value: tx_gain
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1060, 8]
    rotation: 0
    state: enabled
